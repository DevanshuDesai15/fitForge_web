# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI — browser-safe feature controls
VITE_USE_OPENROUTER_AI=true
VITE_OPENROUTER_EMERGENCY_DISABLE=false
VITE_OPENROUTER_TIMEOUT=20000
VITE_OPENROUTER_MAX_RETRIES=1
VITE_AI_PROVIDER_PRIORITY=0.4

# AI server function — server-only, never prefix these with VITE_
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_key
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_EMBEDDING_MODEL=intfloat/multilingual-e5-large
CLERK_SECRET_KEY=sk_test_your_clerk_secret
# Optional alternative to CLERK_SECRET_KEY for networkless JWT verification
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://your-domain.example

# Observability
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional compatibility flag
VITE_HYBRID_MODE=true

# Deprecated VITE_GEMINI_* variables remain supported as lower-priority
# fallbacks for existing deployments. Use the provider-neutral and
# VITE_OPENROUTER_* names above for all new configuration.

# Expo mobile client (publishable values only)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=
